apiVersion: v1
kind: Config
clusters:
- name: production
  cluster:
    # Kubernetes API Server地址，必须能从每个LLDP Agent Pod访问。
    server: https://REPLACE_WITH_KUBERNETES_API_SERVER:6443
    # 目标集群CA证书的Base64内容，不是CA文件路径。
    certificate-authority-data: UkVQTEFDRV9XSVRIX0JBU0U2NF9FTkNPREVEX0NMVVNURVJfQ0E=
users:
- name: lldp-runtime
  user:
    # 仅授予Node get/patch权限的LLDP专用Token。
    token: REPLACE_WITH_LLDP_SERVICE_ACCOUNT_TOKEN
contexts:
- name: production-lldp
  context:
    cluster: production
    user: lldp-runtime
    namespace: ngd-ngg-system
current-context: production-lldp
